{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairiagent.local/schemas/ground_truth_values.schema.json",
  "title": "FAIRiAgent source-grounded GT values",
  "description": "A permissive linked ISA core. Domain fields are allowed and scored only when source-reported.",
  "type": "object",
  "required": ["schema_version", "document_id", "document_source", "annotation", "source_assets", "schema_profile", "isa_sheets"],
  "properties": {
    "schema_version": {"const": "fairiagent.ground_truth_values.v3"},
    "document_id": {"type": "string", "minLength": 1},
    "document_source": {"type": "string", "minLength": 1},
    "publication": {"type": "object", "additionalProperties": true},
    "annotation": {
      "type": "object",
      "required": ["reference_authority", "annotation_method", "review_status", "evidence_policy"],
      "additionalProperties": true
    },
    "source_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary_source", "supplementary_source", "source_metadata"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "schema_profile": {
      "type": "object",
      "required": ["core", "extensions", "field_policy", "omitted_field_semantics"],
      "additionalProperties": true
    },
    "isa_sheets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sheet"}
    }
  },
  "$defs": {
    "sheet": {
      "type": "object",
      "required": ["multi_row", "expected_rows"],
      "properties": {
        "multi_row": {"type": "boolean"},
        "expected_rows": {"type": "array", "items": {"type": "object", "minProperties": 1, "additionalProperties": true}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
