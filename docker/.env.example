# Copy to docker/.env and edit. Compose loads this file automatically.
# Do not commit real secrets.

# --- LLM (pick one provider) ---
# Cloud example (Qwen / DashScope):
LLM_PROVIDER=qwen
FAIRIFIER_LLM_MODEL=qwen-flash
LLM_API_KEY=your_api_key_here
# DASHSCOPE_API_KEY=  # optional alias for Qwen

# Host Ollama example (start `ollama serve` on the host first):
# LLM_PROVIDER=ollama
# FAIRIFIER_LLM_MODEL=qwen3:8b
# FAIRIFIER_LLM_BASE_URL=http://host.docker.internal:11434

# --- Stack defaults (usually leave as-is) ---
# FAIR-DS URL inside Compose is always http://fairds:8083
# (override only if needed via FAIRIFIER_COMPOSE_FAIR_DS_URL)
MINERU_ENABLED=false
MEM0_ENABLED=false
FAIRIFIER_ENABLE_DEEP_AGENTS=true

# If host port 8000 is already in use:
# FAIRIFIER_HOST_PORT=8001
